# Copia este archivo como .env y ajusta los valores. No subas el .env al repositorio.
APP_NOMBRE=PizzaSmart API
APP_ENTORNO=desarrollo
# Orígenes que pueden llamar a la API (el frontend de Vite usa el 5173), separados por comas
CORS_ORIGENES=http://localhost:5173
# Conexión a PostgreSQL (se usará desde T1-09 / T1-10)
DATABASE_URL=postgresql://pizzasmart:cambia_esto@localhost:5432/pizzasmart
